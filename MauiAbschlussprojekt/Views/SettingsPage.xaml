<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiAbschlussprojekt.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAbschlussprojekt.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="⚙️ Einstellungen">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Water Tracker Settings -->
            <Frame BorderColor="#3498DB" CornerRadius="12" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="💧 Wasser-Tracker"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#3498DB"/>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Gewicht (kg)"/>
                        <Entry Text="{Binding WeightInput}"
                               Placeholder="z.B. 75"
                               Keyboard="Numeric"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Aktivitätslevel"/>
                        <Picker ItemsSource="{Binding ActivityLevels}"
                                ItemDisplayBinding="{Binding Display}"
                                SelectedItem="{Binding SelectedActivityLevel}"/>
                    </VerticalStackLayout>

                    <Label Text="{Binding CalculatedGoalText}"
                           IsVisible="{Binding ShowCalculatedGoal}"
                           FontSize="12"
                           TextColor="#27AE60"
                           FontAttributes="Italic"/>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Eigenes Tagesziel (ml)"/>
                        <Entry Text="{Binding CustomGoalInput}"
                               Placeholder="Optional: Eigenes Ziel"
                               Keyboard="Numeric"/>
                    </VerticalStackLayout>

                    <Button Text="💧 Wasser-Einstellungen speichern"
                            Command="{Binding SaveUserSettingsCommand}"
                            BackgroundColor="#3498DB"
                            TextColor="White"
                            CornerRadius="10"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Water Reminders -->
            <Frame BorderColor="#2ECC71" CornerRadius="12" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="🔔 Wasser-Erinnerungen"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#27AE60"/>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Erinnerungen aktivieren"
                               VerticalOptions="Center"
                               HorizontalOptions="StartAndExpand"/>
                        <Switch IsToggled="{Binding ReminderEnabled}"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="15" IsVisible="{Binding ReminderEnabled}">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Intervall (Minuten)"/>
                            <Entry Text="{Binding ReminderIntervalInput}"
                                   Placeholder="z.B. 60"
                                   Keyboard="Numeric"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Start-Uhrzeit"/>
                            <Stepper Value="{Binding ReminderStartHour}"
                                     Minimum="0"
                                     Maximum="23"
                                     Increment="1"/>
                            <Label Text="{Binding ReminderStartHour, StringFormat='{0}:00 Uhr'}"
                                   FontSize="12"
                                   TextColor="Gray"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="End-Uhrzeit"/>
                            <Stepper Value="{Binding ReminderEndHour}"
                                     Minimum="0"
                                     Maximum="23"
                                     Increment="1"/>
                            <Label Text="{Binding ReminderEndHour, StringFormat='{0}:00 Uhr'}"
                                   FontSize="12"
                                   TextColor="Gray"/>
                        </VerticalStackLayout>

                        <Button Text="🔔 Erinnerungen speichern"
                                Command="{Binding SaveReminderSettingsCommand}"
                                BackgroundColor="#27AE60"
                                TextColor="White"
                                CornerRadius="10"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Sleep Tracker Settings -->
            <Frame BorderColor="#9B59B6" CornerRadius="12" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="😴 Schlaf-Tracker"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#9B59B6"/>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Ziel-Schlafdauer (Stunden)"/>
                        <Entry Text="{Binding TargetSleepHoursInput}"
                               Placeholder="z.B. 8"
                               Keyboard="Numeric"/>
                    </VerticalStackLayout>

                    <!-- Ziel-Schlafenszeit -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Ziel-Schlafenszeit" FontAttributes="Bold"/>
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" HorizontalOptions="Center" WidthRequest="270">

                            <!-- Stunden-Picker -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                                <Label Text="Stunden" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                                <Border Stroke="#9B59B6" StrokeThickness="1.5" HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="38,46,38" HeightRequest="46">
                                        <Button Grid.Column="0" Text="−"
                                                Command="{Binding DecrementBedHourCommand}"
                                                BackgroundColor="Transparent" TextColor="#9B59B6"
                                                FontSize="22" FontAttributes="Bold" Padding="0" CornerRadius="0"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding TargetBedTimeHourDisplay}"
                                               FontSize="22" FontAttributes="Bold" TextColor="#9B59B6"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Button Grid.Column="2" Text="+"
                                                Command="{Binding IncrementBedHourCommand}"
                                                BackgroundColor="Transparent" TextColor="#9B59B6"
                                                FontSize="22" FontAttributes="Bold" Padding="0" CornerRadius="0"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Doppelpunkt -->
                            <Label Grid.Column="1" Text=":"
                                   FontSize="30" FontAttributes="Bold" TextColor="#9B59B6"
                                   VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,8"/>

                            <!-- Minuten-Picker -->
                            <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                                <Label Text="Minuten" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                                <Border Stroke="#9B59B6" StrokeThickness="1.5" HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="38,46,38" HeightRequest="46">
                                        <Button Grid.Column="0" Text="−"
                                                Command="{Binding DecrementBedMinuteCommand}"
                                                BackgroundColor="Transparent" TextColor="#9B59B6"
                                                FontSize="22" FontAttributes="Bold" Padding="0" CornerRadius="0"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding TargetBedTimeMinuteDisplay}"
                                               FontSize="22" FontAttributes="Bold" TextColor="#9B59B6"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Button Grid.Column="2" Text="+"
                                                Command="{Binding IncrementBedMinuteCommand}"
                                                BackgroundColor="Transparent" TextColor="#9B59B6"
                                                FontSize="22" FontAttributes="Bold" Padding="0" CornerRadius="0"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{Binding TargetBedTimeDisplay}"
                               FontSize="15" TextColor="Gray" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Ziel-Aufwachzeit -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Ziel-Aufwachzeit" FontAttributes="Bold"/>
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" HorizontalOptions="Center" WidthRequest="270">

                            <!-- Stunden-Picker -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                                <Label Text="Stunden" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                                <Border Stroke="#9B59B6" StrokeThickness="1.5" HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="38,46,38" HeightRequest="46">
                                        <Button Grid.Column="0" Text="−"
                                                Command="{Binding DecrementWakeHourCommand}"
                                                BackgroundColor="Transparent" TextColor="#9B59B6"
                                                FontSize="22" FontAttributes="Bold" Padding="0" CornerRadius="0"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding TargetWakeTimeHourDisplay}"
                                               FontSize="22" FontAttributes="Bold" TextColor="#9B59B6"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Button Grid.Column="2" Text="+"
                                                Command="{Binding IncrementWakeHourCommand}"
                                                BackgroundColor="Transparent" TextColor="#9B59B6"
                                                FontSize="22" FontAttributes="Bold" Padding="0" CornerRadius="0"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Doppelpunkt -->
                            <Label Grid.Column="1" Text=":"
                                   FontSize="30" FontAttributes="Bold" TextColor="#9B59B6"
                                   VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,8"/>

                            <!-- Minuten-Picker -->
                            <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                                <Label Text="Minuten" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                                <Border Stroke="#9B59B6" StrokeThickness="1.5" HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="38,46,38" HeightRequest="46">
                                        <Button Grid.Column="0" Text="−"
                                                Command="{Binding DecrementWakeMinuteCommand}"
                                                BackgroundColor="Transparent" TextColor="#9B59B6"
                                                FontSize="22" FontAttributes="Bold" Padding="0" CornerRadius="0"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding TargetWakeTimeMinuteDisplay}"
                                               FontSize="22" FontAttributes="Bold" TextColor="#9B59B6"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Button Grid.Column="2" Text="+"
                                                Command="{Binding IncrementWakeMinuteCommand}"
                                                BackgroundColor="Transparent" TextColor="#9B59B6"
                                                FontSize="22" FontAttributes="Bold" Padding="0" CornerRadius="0"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{Binding TargetWakeTimeDisplay}"
                               FontSize="15" TextColor="Gray" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Schlaf-Erinnerung -->
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Schlaf-Erinnerung (1h vorher)"
                                   VerticalOptions="Center"
                                   HorizontalOptions="StartAndExpand"/>
                            <Switch IsToggled="{Binding SleepReminderEnabled}"/>
                        </HorizontalStackLayout>
                        <Label Text="ℹ️ Sendet eine Benachrichtigung 1 Stunde vor der Ziel-Schlafenszeit."
                               FontSize="11" TextColor="Gray"
                               IsVisible="{Binding SleepReminderEnabled}"/>
                    </VerticalStackLayout>

                    <Button Text="😴 Schlaf-Einstellungen speichern"
                            Command="{Binding SaveSleepSettingsCommand}"
                            BackgroundColor="#9B59B6"
                            TextColor="White"
                            CornerRadius="10"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Logout Button -->
            <Button Text="🚪 Abmelden"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="#E74C3C"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Margin="0,20,0,0"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="#3498DB"
                             Margin="20"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
