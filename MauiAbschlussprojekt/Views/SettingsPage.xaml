<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiAbschlussprojekt.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAbschlussprojekt.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Einstellungen"
             BackgroundColor="#F0F4F8">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#9EAAB6"/>
                <Setter Property="CharacterSpacing" Value="1"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextColor" Value="#6C757D"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="StrokeThickness" Value="0"/>
                <Setter Property="Padding" Value="18"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="14">

            <Label Text="PROFIL" Style="{StaticResource SectionTitle}" Margin="4,4,4,0"/>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1A2535" Opacity="0.07" Radius="10" Offset="0,3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">

                    <Label Style="{StaticResource FieldLabel}" Text="Benutzername"/>
                    <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding Username}"
                               FontSize="15" TextColor="#1A2535"
                               BackgroundColor="Transparent" Margin="12,0" HeightRequest="48"/>
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Körpergewicht (kg)"/>
                    <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding WeightInput}"
                               Keyboard="Numeric" FontSize="15" TextColor="#1A2535"
                               BackgroundColor="Transparent" Margin="12,0" HeightRequest="48"/>
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Aktivitätslevel"/>
                    <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Picker ItemsSource="{Binding ActivityLevels}"
                                ItemDisplayBinding="{Binding Display}"
                                SelectedItem="{Binding SelectedActivityLevel}"
                                TextColor="#1A2535" TitleColor="#9EAAB6"
                                Title="Bitte wählen..." Margin="12,0"/>
                    </Border>

                    <Label Text="{Binding CalculatedGoalText}"
                           FontSize="13" FontAttributes="Bold" TextColor="#1A73E8"
                           IsVisible="{Binding ShowCalculatedGoal}"/>

                    <Button Text="Profil speichern"
                            Command="{Binding SaveProfileCommand}"
                            BackgroundColor="#1A73E8" TextColor="White"
                            FontAttributes="Bold" CornerRadius="12" HeightRequest="48"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="WASSER-TRACKER" Style="{StaticResource SectionTitle}" Margin="4,4,4,0"/>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1A2535" Opacity="0.07" Radius="10" Offset="0,3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">

                    <Label Style="{StaticResource FieldLabel}" Text="Tagesziel (ml)"/>
                    <VerticalStackLayout Spacing="10">
                        <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry Text="{Binding CustomGoalInput}"
                                   Keyboard="Numeric" FontSize="15" TextColor="#1A2535"
                                   BackgroundColor="Transparent" Margin="12,0" HeightRequest="48"/>
                        </Border>

                        <!-- Info über berechneten Wert + Übernehmen Button -->
                        <!-- Nur sichtbar wenn: 1) ShowCalculatedGoal=true UND 2) CustomGoalInput ist leer -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" 
                              IsVisible="{Binding ShowCalculatedGoal}">
                            <Label Grid.Column="0" Text="{Binding CalculatedGoalText}"
                                   FontSize="12" TextColor="#1A73E8" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="Übernehmen"
                                    Command="{Binding UseCalculatedGoalCommand}"
                                    BackgroundColor="#1A73E8" TextColor="White"
                                    FontAttributes="Bold" CornerRadius="8" HeightRequest="36"
                                    Padding="12,8" FontSize="12"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Trink-Erinnerungen Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Trink-Erinnerungen" FontSize="14" TextColor="#1A2535" FontAttributes="Bold"/>
                            <Label Text="Regelmäßige Push-Benachrichtigungen" FontSize="12" TextColor="#9EAAB6"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding ReminderEnabled}"
                                OnColor="#1A73E8" VerticalOptions="Center"/>
                    </Grid>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding ReminderEnabled}">
                        <Label Style="{StaticResource FieldLabel}" Text="Intervall (Minuten)"/>
                        <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry Text="{Binding ReminderIntervalInput}"
                                   Keyboard="Numeric" FontSize="15" TextColor="#1A2535"
                                   BackgroundColor="Transparent" Margin="12,0" HeightRequest="48"/>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Style="{StaticResource FieldLabel}" Text="Von (Stunde)"/>
                                <Stepper Value="{Binding ReminderStartHour}" Minimum="0" Maximum="23" Increment="1"/>
                                <Label Text="{Binding ReminderStartHour, StringFormat='{0}:00 Uhr'}"
                                       FontSize="12" TextColor="#1A73E8" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Style="{StaticResource FieldLabel}" Text="Bis (Stunde)"/>
                                <Stepper Value="{Binding ReminderEndHour}" Minimum="0" Maximum="23" Increment="1"/>
                                <Label Text="{Binding ReminderEndHour, StringFormat='{0}:00 Uhr'}"
                                       FontSize="12" TextColor="#1A73E8" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <Button Text="Wasser-Einstellungen speichern"
                            Command="{Binding SaveReminderSettingsCommand}"
                            BackgroundColor="#EBF2FF" TextColor="#1A73E8"
                            FontAttributes="Bold" CornerRadius="12" HeightRequest="48"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="SCHLAF-TRACKER" Style="{StaticResource SectionTitle}" Margin="4,4,4,0"/>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1A2535" Opacity="0.07" Radius="10" Offset="0,3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">

                    <Label Style="{StaticResource FieldLabel}" Text="Ziel-Schlafdauer (Stunden)"/>
                    <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding TargetSleepHoursInput}"
                               Keyboard="Numeric" Placeholder="z.B. 8"
                               FontSize="15" TextColor="#1A2535" PlaceholderColor="#9EAAB6"
                               BackgroundColor="Transparent" Margin="12,0" HeightRequest="48"/>
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Ziel-Schlafenszeit"/>
                    <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <TimePicker Time="{Binding TargetBedTime, Mode=TwoWay}"
                                    Format="HH:mm" TextColor="#1A2535" Margin="12,0"/>
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Ziel-Aufwachzeit"/>
                    <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <TimePicker Time="{Binding TargetWakeTime, Mode=TwoWay}"
                                    Format="HH:mm" TextColor="#1A2535" Margin="12,0"/>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Schlaf-Erinnerung" FontSize="14" TextColor="#1A2535" FontAttributes="Bold"/>
                            <Label Text="1 Stunde vor Schlafenszeit" FontSize="12" TextColor="#9EAAB6"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding SleepReminderEnabled}"
                                OnColor="#7C3AED" VerticalOptions="Center"/>
                    </Grid>

                    <Button Text="Schlaf-Einstellungen speichern"
                            Command="{Binding SaveSleepSettingsCommand}"
                            BackgroundColor="#EDE9FE" TextColor="#7C3AED"
                            FontAttributes="Bold" CornerRadius="12" HeightRequest="48"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Abmelden -->
            <Button Text="Abmelden"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="#FEF0F0" TextColor="#E05252"
                    FontAttributes="Bold" FontSize="15"
                    CornerRadius="12" HeightRequest="50"
                    Margin="0,4,0,0"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="#1A73E8" Margin="20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>