<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAbschlussprojekt.Views.AddSleepEntryPage"
             Title="Nacht hinzufügen">

    <!-- KEIN x:DataType hier – verhindert compiled-binding Konflikte mit Picker/Slider -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Frame">
                <Setter Property="BorderColor" Value="LightGray"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="HasShadow" Value="False"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Schlafdauer-Zusammenfassung -->
            <Border StrokeThickness="2" Stroke="#9B59B6" BackgroundColor="#F5EEF8" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Geschätzte Schlafdauer" FontSize="13" TextColor="Gray"
                           HorizontalOptions="Center"/>
                    <Label x:Name="SleepDurationLabel"
                           FontSize="28" FontAttributes="Bold" TextColor="#9B59B6"
                           HorizontalOptions="Center"/>
                    <Label x:Name="WarningLabel"
                           FontSize="12" TextColor="#E74C3C" HorizontalOptions="Center"
                           IsVisible="False"/>
                </VerticalStackLayout>
            </Border>

            <!-- Zeiten -->
            <Frame>
                <VerticalStackLayout Spacing="15">
                    <Label Text="Zeiten" FontSize="18" FontAttributes="Bold"/>

                    <!-- Ins Bett -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Ins Bett gegangen" FontAttributes="Bold"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Datum" FontSize="11" TextColor="Gray"/>
                                <DatePicker x:Name="BedDatePicker" Format="dd.MM.yyyy"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Uhrzeit" FontSize="11" TextColor="Gray"/>
                                <TimePicker x:Name="BedTimePicker" Format="HH:mm"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Label x:Name="BedTimeDisplayLabel" FontSize="12" TextColor="Gray"/>
                    </VerticalStackLayout>

                    <!-- Aufgewacht -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Aufgewacht" FontAttributes="Bold"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Datum" FontSize="11" TextColor="Gray"/>
                                <DatePicker x:Name="WakeDatePicker" Format="dd.MM.yyyy"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Uhrzeit" FontSize="11" TextColor="Gray"/>
                                <TimePicker x:Name="WakeTimePicker" Format="HH:mm"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Label x:Name="WakeTimeDisplayLabel" FontSize="12" TextColor="Gray"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Einschlafdauer -->
            <Frame>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Einschlafdauer" FontSize="18" FontAttributes="Bold"/>
                    <Picker x:Name="FallAsleepPicker" Title="Bitte wählen..."/>
                </VerticalStackLayout>
            </Frame>

            <!-- Schlafqualität -->
            <Frame>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Schlafqualität" FontSize="18" FontAttributes="Bold"/>
                    <Label x:Name="QualityLabel" FontSize="16" HorizontalOptions="Center"/>
                    <Slider x:Name="QualitySlider" Minimum="1" Maximum="5"
                            MinimumTrackColor="#9B59B6" MaximumTrackColor="LightGray"/>
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <Label Grid.Column="0" Text="1" FontSize="14" HorizontalOptions="Center"/>
                        <Label Grid.Column="1" Text="2" FontSize="14" HorizontalOptions="Center"/>
                        <Label Grid.Column="2" Text="3" FontSize="14" HorizontalOptions="Center"/>
                        <Label Grid.Column="3" Text="4" FontSize="14" HorizontalOptions="Center"/>
                        <Label Grid.Column="4" Text="5" FontSize="14" HorizontalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Traumtagebuch -->
            <Frame>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Traumtagebuch (optional)" FontSize="18" FontAttributes="Bold"/>
                    <Editor x:Name="DreamTextEditor"
                            Placeholder="Was hast du geträumt?"
                            HeightRequest="80" AutoSize="TextChanges"/>
                    <VerticalStackLayout x:Name="DreamMoodSection" Spacing="5" IsVisible="False">
                        <Label Text="Traumstimmung" FontSize="13"/>
                        <Picker x:Name="DreamMoodPicker" Title="Bitte wählen..."/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Notizen -->
            <Frame>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Notizen (optional)" FontSize="18" FontAttributes="Bold"/>
                    <Editor x:Name="NotesEditor"
                            Placeholder="Besonderheiten, Gefühle, ..."
                            HeightRequest="70" AutoSize="TextChanges"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="Abbrechen" x:Name="CancelButton"
                        BackgroundColor="#95A5A6" TextColor="White"
                        CornerRadius="10" HeightRequest="50"/>
                <Button Grid.Column="1" Text="Speichern" x:Name="SaveButton"
                        BackgroundColor="#27AE60" TextColor="White"
                        CornerRadius="10" HeightRequest="50" FontAttributes="Bold"/>
            </Grid>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False" IsVisible="False"
                               Color="#9B59B6" Margin="20"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
