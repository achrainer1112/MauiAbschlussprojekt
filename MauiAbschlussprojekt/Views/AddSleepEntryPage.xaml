<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiAbschlussprojekt.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAbschlussprojekt.Views.AddSleepEntryPage"
             x:DataType="viewmodels:AddSleepEntryViewModel"
             Title="Nacht hinzufügen">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Schlafdauer-Zusammenfassung -->
            <Border StrokeThickness="2"
                    Stroke="#3498DB"
                    BackgroundColor="#E8F4F8"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Geschätzte Schlafdauer"
                           FontSize="13" TextColor="Gray" HorizontalOptions="Center"/>
                    <Label Text="{Binding CalculatedSleepHours, StringFormat='{0:F1} Stunden'}"
                           FontSize="28" FontAttributes="Bold" TextColor="#3498DB"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding SleepDurationWarning}"
                           FontSize="12" TextColor="#E74C3C"
                           HorizontalOptions="Center"
                           IsVisible="{Binding HasWarning}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Zeiten -->
            <Frame BorderColor="LightGray" CornerRadius="10" Padding="15" HasShadow="False">
                <VerticalStackLayout Spacing="15">
                    <Label Text="⏰ Zeiten" FontSize="18" FontAttributes="Bold"/>

                    <!-- Ins Bett -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🛏️ Ins Bett gegangen" FontAttributes="Bold"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Datum" FontSize="11" TextColor="Gray"/>
                                <DatePicker Date="{Binding BedDate, Mode=TwoWay}"
                                            Format="dd.MM.yyyy"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Uhrzeit" FontSize="11" TextColor="Gray"/>
                                <TimePicker Time="{Binding BedTimeSpan, Mode=TwoWay}"
                                            Format="HH:mm"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{Binding BedTime, StringFormat='🛏️ {0:ddd, dd.MM. – HH:mm} Uhr'}"
                               FontSize="12" TextColor="Gray"/>
                    </VerticalStackLayout>

                    <!-- Aufgewacht -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="☀️ Aufgewacht" FontAttributes="Bold"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Datum" FontSize="11" TextColor="Gray"/>
                                <DatePicker Date="{Binding WakeDate, Mode=TwoWay}"
                                            Format="dd.MM.yyyy"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Uhrzeit" FontSize="11" TextColor="Gray"/>
                                <TimePicker Time="{Binding WakeTimeSpan, Mode=TwoWay}"
                                            Format="HH:mm"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{Binding WakeTime, StringFormat='☀️ {0:ddd, dd.MM. – HH:mm} Uhr'}"
                               FontSize="12" TextColor="Gray"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Einschlafdauer -->
            <Frame BorderColor="LightGray" CornerRadius="10" Padding="15" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="⏱️ Einschlafdauer" FontSize="18" FontAttributes="Bold"/>
                    <Picker ItemsSource="{Binding FallAsleepCategories}"
                            SelectedItem="{Binding SelectedFallAsleepCategory}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Schlafqualität -->
            <Frame BorderColor="LightGray" CornerRadius="10" Padding="15" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="⭐ Schlafqualität" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="{Binding SleepQuality, StringFormat='Bewertung: {0}/5'}"
                           FontSize="16" HorizontalOptions="Center"/>
                    <Slider Value="{Binding SleepQuality, Mode=TwoWay}"
                            Minimum="1" Maximum="5"/>
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <Label Grid.Column="0" Text="😴 Schlecht"  FontSize="10" HorizontalOptions="Center"/>
                        <Label Grid.Column="1" Text="😕"           FontSize="18" HorizontalOptions="Center"/>
                        <Label Grid.Column="2" Text="😐 Okay"      FontSize="10" HorizontalOptions="Center"/>
                        <Label Grid.Column="3" Text="🙂"           FontSize="18" HorizontalOptions="Center"/>
                        <Label Grid.Column="4" Text="😄 Super"     FontSize="10" HorizontalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Traumtagebuch -->
            <Frame BorderColor="LightGray" CornerRadius="10" Padding="15" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="💭 Traumtagebuch (optional)" FontSize="18" FontAttributes="Bold"/>
                    <Editor Text="{Binding DreamText}"
                            Placeholder="Was hast du geträumt?"
                            HeightRequest="80"
                            AutoSize="TextChanges"/>
                    <VerticalStackLayout Spacing="5" IsVisible="{Binding HasDreamText}">
                        <Label Text="Traumstimmung" FontSize="13"/>
                        <Picker ItemsSource="{Binding DreamMoods}"
                                SelectedItem="{Binding SelectedDreamMood}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Notizen -->
            <Frame BorderColor="LightGray" CornerRadius="10" Padding="15" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📝 Notizen (optional)" FontSize="18" FontAttributes="Bold"/>
                    <Editor Text="{Binding Notes}"
                            Placeholder="Besonderheiten, Gefühle, ..."
                            HeightRequest="70"
                            AutoSize="TextChanges"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Speichern -->
            <Button Text="💾 Speichern"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#9B59B6"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="#9B59B6"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
