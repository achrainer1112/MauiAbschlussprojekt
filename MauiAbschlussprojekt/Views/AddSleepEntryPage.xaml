<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAbschlussprojekt.Views.AddSleepEntryPage"
             Title="Nacht hinzufügen"
             BackgroundColor="#F0F4F8">

    <ContentPage.Resources>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="#9EAAB6"/>
            <Setter Property="CharacterSpacing" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextColor" Value="#6C757D"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="14">

            
            <Border BackgroundColor="#EDE9FE" StrokeThickness="2" Stroke="#7C3AED" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="GESCHÄTZTE SCHLAFDAUER" Style="{StaticResource SectionTitle}"
                           HorizontalOptions="Center"/>
                    <Label x:Name="SleepDurationLabel"
                           FontSize="30" FontAttributes="Bold"
                           TextColor="#7C3AED" HorizontalOptions="Center"/>
                    <Label x:Name="WarningLabel"
                           FontSize="12" TextColor="#E05252"
                           HorizontalOptions="Center" IsVisible="False"/>
                </VerticalStackLayout>
            </Border>

            
            <Label Text="SCHLAFZEITEN" Style="{StaticResource SectionTitle}" Margin="4,0"/>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1A2535" Opacity="0.07" Radius="10" Offset="0,3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">

                    
                    <Label Text="Ins Bett gegangen" FontSize="14" FontAttributes="Bold" TextColor="#1A2535"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Datum" Style="{StaticResource FieldLabel}"/>
                            <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <DatePicker x:Name="BedDatePicker" Format="dd.MM.yyyy"
                                            TextColor="#1A2535" Margin="8,0"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Uhrzeit" Style="{StaticResource FieldLabel}"/>
                            <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <TimePicker x:Name="BedTimePicker" Format="HH:mm"
                                            TextColor="#1A2535" Margin="8,0"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    
                    <Label Text="Aufgewacht" FontSize="14" FontAttributes="Bold"
                           TextColor="#1A2535" Margin="0,8,0,0"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Datum" Style="{StaticResource FieldLabel}"/>
                            <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <DatePicker x:Name="WakeDatePicker" Format="dd.MM.yyyy"
                                            TextColor="#1A2535" Margin="8,0"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Uhrzeit" Style="{StaticResource FieldLabel}"/>
                            <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <TimePicker x:Name="WakeTimePicker" Format="HH:mm"
                                            TextColor="#1A2535" Margin="8,0"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            
            <Label Text="EINSCHLAFDAUER" Style="{StaticResource SectionTitle}" Margin="4,0"/>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1A2535" Opacity="0.07" Radius="10" Offset="0,3"/>
                </Border.Shadow>
                <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="FallAsleepPicker"
                            Title="Bitte wählen..."
                            TitleColor="#9EAAB6"
                            TextColor="#1A2535"
                            Margin="12,0"/>
                </Border>
            </Border>

            
            <Label Text="SCHLAFQUALITÄT" Style="{StaticResource SectionTitle}" Margin="4,0"/>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1A2535" Opacity="0.07" Radius="10" Offset="0,3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="QualityLabel"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="#F39C12" HorizontalOptions="Center"/>
                    <Slider x:Name="QualitySlider"
                            Minimum="1" Maximum="5"
                            MinimumTrackColor="#7C3AED"
                            MaximumTrackColor="#E8EDF2"
                            ThumbColor="#7C3AED"/>
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <Label Grid.Column="0" Text="1" FontSize="12"
                               TextColor="#9EAAB6" HorizontalOptions="Center"/>
                        <Label Grid.Column="1" Text="2" FontSize="12"
                               TextColor="#9EAAB6" HorizontalOptions="Center"/>
                        <Label Grid.Column="2" Text="3" FontSize="12"
                               TextColor="#9EAAB6" HorizontalOptions="Center"/>
                        <Label Grid.Column="3" Text="4" FontSize="12"
                               TextColor="#9EAAB6" HorizontalOptions="Center"/>
                        <Label Grid.Column="4" Text="5" FontSize="12"
                               TextColor="#9EAAB6" HorizontalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            
            <Label Text="TRAUMTAGEBUCH (OPTIONAL)" Style="{StaticResource SectionTitle}" Margin="4,0"/>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1A2535" Opacity="0.07" Radius="10" Offset="0,3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Editor x:Name="DreamTextEditor"
                            Placeholder="Was hast du geträumt?"
                            PlaceholderColor="#9EAAB6"
                            TextColor="#1A2535"
                            BackgroundColor="Transparent"
                            HeightRequest="80"
                            AutoSize="TextChanges"/>

                    <VerticalStackLayout x:Name="DreamMoodSection" Spacing="6" IsVisible="False">
                        <Label Text="Traumstimmung" Style="{StaticResource FieldLabel}"/>
                        <Border StrokeThickness="1" Stroke="#E8EDF2" BackgroundColor="#F8FAFC">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Picker x:Name="DreamMoodPicker"
                                    Title="Bitte wählen..."
                                    TitleColor="#9EAAB6"
                                    TextColor="#1A2535"
                                    Margin="12,0"/>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            
            <Label Text="NOTIZEN (OPTIONAL)" Style="{StaticResource SectionTitle}" Margin="4,0"/>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1A2535" Opacity="0.07" Radius="10" Offset="0,3"/>
                </Border.Shadow>
                <Editor x:Name="NotesEditor"
                        Placeholder="Besonderheiten, Gefühle, ..."
                        PlaceholderColor="#9EAAB6"
                        TextColor="#1A2535"
                        BackgroundColor="Transparent"
                        HeightRequest="70"
                        AutoSize="TextChanges"/>
            </Border>

            
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                <Button Grid.Column="0"
                        x:Name="CancelButton"
                        Text="Abbrechen"
                        BackgroundColor="#F0F4F8" TextColor="#6C757D"
                        FontAttributes="Bold" CornerRadius="12" HeightRequest="50"/>
                <Button Grid.Column="1"
                        x:Name="SaveButton"
                        Text="Speichern"
                        BackgroundColor="#7C3AED" TextColor="White"
                        FontAttributes="Bold" CornerRadius="12" HeightRequest="50"/>
            </Grid>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False" IsVisible="False"
                               Color="#7C3AED" Margin="20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
