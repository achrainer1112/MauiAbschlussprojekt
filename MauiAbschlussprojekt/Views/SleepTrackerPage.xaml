<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiAbschlussprojekt.ViewModels"
             xmlns:models="clr-namespace:Models;assembly=Models"
             x:Class="MauiAbschlussprojekt.Views.SleepTrackerPage"
             x:DataType="viewmodels:SleepTrackerViewModel"
             Title="Schlaf-Tracker"
             BackgroundColor="#F0F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="14">

            <!-- Begrüßung -->
            <Border BackgroundColor="#7C3AED" StrokeThickness="0" Padding="20,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{Binding Username, StringFormat='Guten Morgen, {0} 🌙'}"
                               FontSize="18" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="{Binding TargetSleepHours, StringFormat='Schlafziel: {0:F1}h'}"
                               FontSize="13" TextColor="#E9D5FF"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="😴" FontSize="36" VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Letzte Nacht -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16"
                    IsVisible="{Binding HasLastNightData}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1A2535" Opacity="0.06" Radius="8" Offset="0,3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <Label Text="LETZTE NACHT" FontSize="10" FontAttributes="Bold"
                           TextColor="#9EAAB6" CharacterSpacing="1"/>
                    <Label Text="{Binding LastNightSummary}"
                           FontSize="16" FontAttributes="Bold" TextColor="#1A2535"/>
                    <ProgressBar Progress="{Binding LastNightProgress}"
                                 ProgressColor="#7C3AED" BackgroundColor="#F3E8FF"
                                 HeightRequest="8"/>
                </VerticalStackLayout>
            </Border>

            <!-- Quick-Log Buttons -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1A2535" Opacity="0.06" Radius="8" Offset="0,3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <Label Text="QUICK-LOG" FontSize="10" FontAttributes="Bold"
                           TextColor="#9EAAB6" CharacterSpacing="1"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="🛏️  Ins Bett"
                                Command="{Binding QuickLogBedtimeCommand}"
                                BackgroundColor="#EDE9FE" TextColor="#7C3AED"
                                FontAttributes="Bold" FontSize="14"
                                CornerRadius="10" HeightRequest="46"/>
                        <Button Grid.Column="1"
                                Text="☀️  Aufgewacht"
                                Command="{Binding QuickLogWakeupCommand}"
                                BackgroundColor="#FEF3C7" TextColor="#D97706"
                                FontAttributes="Bold" FontSize="14"
                                CornerRadius="10" HeightRequest="46"/>
                    </Grid>
                    <Label IsVisible="{Binding BedTimeLogged}"
                           TextColor="#7C3AED" FontSize="12" HorizontalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="🛏️ Bettzeit gespeichert: "/>
                                <Span Text="{Binding BedTimeDisplay}" FontAttributes="Bold"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Aktions-Buttons -->
            <Button Text="➕  Nacht manuell eintragen"
                    Command="{Binding AddManualEntryCommand}"
                    BackgroundColor="#1A73E8" TextColor="White"
                    FontAttributes="Bold" FontSize="15"
                    CornerRadius="12" HeightRequest="50"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="📊  Statistiken"
                        Command="{Binding NavigateToStatsCommand}"
                        BackgroundColor="#EBF2FF" TextColor="#1A73E8"
                        FontAttributes="Bold" FontSize="14"
                        CornerRadius="12" HeightRequest="46"/>
                <Button Grid.Column="1"
                        Text="💭  Träume"
                        Command="{Binding NavigateToDreamsCommand}"
                        BackgroundColor="#F3E8FF" TextColor="#7C3AED"
                        FontAttributes="Bold" FontSize="14"
                        CornerRadius="12" HeightRequest="46"/>
            </Grid>

            <!-- Letzte Einträge -->
            <Label Text="LETZTE EINTRÄGE" FontSize="11" FontAttributes="Bold"
                   TextColor="#9EAAB6" CharacterSpacing="1" Margin="4,4,4,0"/>

            <RefreshView Command="{Binding LoadDataCommand}">
                <CollectionView ItemsSource="{Binding RecentEntries}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="30" Spacing="8">
                            <Label Text="😴" FontSize="44" HorizontalOptions="Center"/>
                            <Label Text="Noch keine Schlafeinträge"
                                   FontSize="14" TextColor="#9EAAB6" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SleepEntryDto">
                            <Border BackgroundColor="White" StrokeThickness="0" Margin="0,0,0,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#1A2535" Opacity="0.05" Radius="6" Offset="0,2"/>
                                </Border.Shadow>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Padding="14,12">

                                    <!-- Datum-Icon -->
                                    <Frame Grid.Column="0" BackgroundColor="#EDE9FE" CornerRadius="10"
                                           WidthRequest="42" HeightRequest="42" HasShadow="False" Padding="0">
                                        <Label Text="🌙" FontSize="18"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Frame>

                                    <!-- Infos -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Label Text="{Binding BedTime, StringFormat='{0:dd.MM.} — {0:HH:mm}'}"
                                               FontSize="14" FontAttributes="Bold" TextColor="#1A2535"/>
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding TotalSleepHours, StringFormat='{0:F1} h'}"
                                                   FontSize="12" TextColor="#6C757D"/>
                                            <Label Text="·" FontSize="12" TextColor="#9EAAB6"/>
                                            <Label Text="{Binding SleepQuality, StringFormat='⭐ {0}'}"
                                                   FontSize="12" TextColor="#F39C12"/>
                                        </HorizontalStackLayout>
                                        <!-- Traum-Badge -->
                                        <Border BackgroundColor="#F3E8FF" Padding="6,2"
                                                IsVisible="{Binding DreamText, Converter={x:StaticResource StringNotNullOrEmptyBoolConverter}}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="💭 Traum aufgezeichnet" FontSize="10" TextColor="#7C3AED"/>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Bearbeiten -->
                                    <Button Grid.Column="2" Text="✏️"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SleepTrackerViewModel}}, Path=ViewEntryDetailsCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EBF2FF" TextColor="#1A73E8"
                                            FontSize="13" CornerRadius="8"
                                            WidthRequest="38" HeightRequest="36"
                                            Padding="0" VerticalOptions="Center"/>

                                    <!-- Löschen -->
                                    <Button Grid.Column="3" Text="🗑️"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SleepTrackerViewModel}}, Path=DeleteEntryCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FEE2E2" TextColor="#E74C3C"
                                            FontSize="13" CornerRadius="8"
                                            WidthRequest="38" HeightRequest="36"
                                            Padding="0" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="#7C3AED" Margin="20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>