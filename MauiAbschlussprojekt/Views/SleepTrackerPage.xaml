<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiAbschlussprojekt.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:Models;assembly=Models"
             x:Class="MauiAbschlussprojekt.Views.SleepTrackerPage"
             x:DataType="viewmodels:SleepTrackerViewModel"
             Title="😴 Schlaf-Tracker">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="{Binding Username, StringFormat='Gute Nacht, {0}'}"
                   FontSize="20"
                   FontAttributes="Bold"/>

            <!-- Last Night Summary -->
            <Frame BorderColor="#9B59B6" CornerRadius="15" Padding="15" HasShadow="True">
                <Grid>
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasLastNightData}">
                        <Label Text="Letzte Nacht"
                               FontSize="14"
                               TextColor="Gray"
                               HorizontalOptions="Start"/>
                        <Label Text="{Binding LastNightSummary}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#2C3E50"
                               HorizontalOptions="Start"
                               HorizontalTextAlignment="Start"/>
                        <Label Text="{Binding LastNightQuality, StringFormat='Qualität: {0}/5'}"
                               FontSize="12"
                               TextColor="#F39C12"
                               HorizontalOptions="Start"/>
                    </VerticalStackLayout>

                    <Label Text="{Binding LastNightSummary}"
                           IsVisible="{Binding HasLastNightData, Converter={StaticResource InvertedBoolConverter}}"
                           TextColor="Gray"
                           FontSize="16"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="20"/>
                </Grid>
            </Frame>

            <!-- Quick Actions -->
            <Label Text="Schnellaktionen"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                <!-- Ins Bett Button -->
                <Frame Grid.Column="0"
                       BorderColor="#9B59B6"
                       CornerRadius="12"
                       Padding="15"
                       HasShadow="True"
                       Opacity="{Binding BedTimeLogged, Converter={toolkit:BoolToObjectConverter TrueObject='0.45', FalseObject='1.0'}}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding QuickLogBedtimeCommand}" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🛏️" FontSize="36" HorizontalOptions="Center"/>
                        <Label Text="Ins Bett"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <!-- Zeigt "Jetzt" vor dem Drücken, danach die gespeicherte Uhrzeit -->
                        <Label Text="Jetzt"
                               FontSize="11"
                               TextColor="Gray"
                               HorizontalOptions="Center"
                               IsVisible="{Binding BedTimeLogged, Converter={StaticResource InvertedBoolConverter}}"/>
                        <Label Text="{Binding BedTimeDisplay}"
                               FontSize="11"
                               TextColor="#9B59B6"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               IsVisible="{Binding BedTimeLogged}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Aufgewacht Button -->
                <Frame Grid.Column="1"
                       BorderColor="#E74C3C"
                       CornerRadius="12"
                       Padding="15"
                       HasShadow="True"
                       Opacity="{Binding BedTimeLogged, Converter={toolkit:BoolToObjectConverter TrueObject='1.0', FalseObject='0.45'}}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding QuickLogWakeupCommand}" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="☀️" FontSize="36" HorizontalOptions="Center"/>
                        <Label Text="Aufgewacht"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="Jetzt"
                               FontSize="11"
                               TextColor="Gray"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

            </Grid>

            <!-- Hinweis wenn Einschlafzeit bereits gespeichert -->
            <Label IsVisible="{Binding BedTimeLogged}"
                   TextColor="#9B59B6"
                   FontSize="13"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="🛏️ Einschlafzeit gespeichert: "/>
                        <Span Text="{Binding BedTimeDisplay}" FontAttributes="Bold"/>
                        <Span Text="  &#x2013;  Drücke ☀️ wenn du aufwachst!"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Button Text="Nacht manuell hinzufügen"
                    Command="{Binding AddManualEntryCommand}"
                    BackgroundColor="#3498DB"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontAttributes="Bold"/>

            <Button Text="Statistiken anzeigen"
                    Command="{Binding NavigateToStatsCommand}"
                    BackgroundColor="#27AE60"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"/>

            <!-- Recent Entries -->
            <Label Text="Letzte Einträge"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,0"/>

            <RefreshView Command="{Binding LoadDataCommand}">
                <CollectionView ItemsSource="{Binding RecentEntries}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" Spacing="10">
                            <Label Text="😴" FontSize="60" HorizontalOptions="Center"/>
                            <Label Text="Noch keine Schlafeinträge"
                                   FontSize="14"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SleepEntryDto">
                            <Frame BorderColor="LightGray"
                                   CornerRadius="8"
                                   Padding="12"
                                   Margin="0,0,0,8"
                                   HasShadow="False">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding BedTime, StringFormat='{0:dd.MM.yyyy}'}"
                                               FontSize="13"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding BedTime, StringFormat='Beginn: {0:HH:mm}'}"
                                               FontSize="12"
                                               TextColor="#555"/>
                                        <Label Text="{Binding WakeTime, StringFormat='Ende: {0:HH:mm}'}"
                                               FontSize="12"
                                               TextColor="#555"/>
                                        <Label Text="{Binding TotalSleepHours, StringFormat='Dauer: {0:F1}h'}"
                                               FontSize="12"
                                               TextColor="#27AE60"/>
                                        <Label Text="{Binding SleepQuality, StringFormat='Qualität: {0}/5'}"
                                               FontSize="12"
                                               TextColor="#F39C12"/>
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1"
                                            Text="Löschen"
                                            BackgroundColor="#E74C3C"
                                            TextColor="White"
                                            CornerRadius="8"
                                            WidthRequest="80"
                                            HeightRequest="36"
                                            Padding="0"
                                            VerticalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SleepTrackerViewModel}}, Path=DeleteEntryCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="#9B59B6"
                             Margin="20"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
