<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiAbschlussprojekt.ViewModels"
             xmlns:models="clr-namespace:Models;assembly=Models"
             x:Class="MauiAbschlussprojekt.Views.SleepStatsPage"
             x:DataType="viewmodels:SleepStatsViewModel"
             Title="Schlaf-Statistiken"
             BackgroundColor="#F0F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="14">

            <!-- Übersichtskacheln -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="12" RowSpacing="12">

                <Border Grid.Column="0" Grid.Row="0" BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#1A2535" Opacity="0.06" Radius="8" Offset="0,3"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Ø SCHLAF" FontSize="10" FontAttributes="Bold"
                               TextColor="#9EAAB6" CharacterSpacing="1"/>
                        <Label Text="{Binding AverageSleepHours, StringFormat='{0:F1} h'}"
                               FontSize="22" FontAttributes="Bold" TextColor="#7C3AED"/>
                        <Label Text="pro Nacht" FontSize="12" TextColor="#9EAAB6"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Grid.Row="0" BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#1A2535" Opacity="0.06" Radius="8" Offset="0,3"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="STREAK" FontSize="10" FontAttributes="Bold"
                               TextColor="#9EAAB6" CharacterSpacing="1"/>
                        <Label Text="{Binding CurrentStreak, StringFormat='🔥 {0} Tage'}"
                               FontSize="20" FontAttributes="Bold" TextColor="#E74C3C"/>
                        <Label Text="aktuell" FontSize="12" TextColor="#9EAAB6"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="0" Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#1A2535" Opacity="0.06" Radius="8" Offset="0,3"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="QUALITÄT Ø" FontSize="10" FontAttributes="Bold"
                               TextColor="#9EAAB6" CharacterSpacing="1"/>
                        <Label Text="{Binding AverageSleepQuality, StringFormat='⭐ {0:F1}/5'}"
                               FontSize="20" FontAttributes="Bold" TextColor="#F39C12"/>
                        <Label Text="Bewertung" FontSize="12" TextColor="#9EAAB6"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#1A2535" Opacity="0.06" Radius="8" Offset="0,3"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="BESTER STREAK" FontSize="10" FontAttributes="Bold"
                               TextColor="#9EAAB6" CharacterSpacing="1"/>
                        <Label Text="{Binding BestStreak, StringFormat='🏆 {0} Tage'}"
                               FontSize="20" FontAttributes="Bold" TextColor="#34A853"/>
                        <Label Text="Rekord" FontSize="12" TextColor="#9EAAB6"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Letzte Einträge -->
            <Label Text="LETZTE NÄCHTE" FontSize="11" FontAttributes="Bold"
                   TextColor="#9EAAB6" CharacterSpacing="1" Margin="4,4,4,0"/>

            <CollectionView ItemsSource="{Binding RecentEntries}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30" Spacing="8">
                        <Label Text="😴" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="Noch keine Einträge" FontSize="14"
                               TextColor="#9EAAB6" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SleepEntryDto">
                        <Border BackgroundColor="White" StrokeThickness="0" Margin="0,0,0,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#1A2535" Opacity="0.05" Radius="6" Offset="0,2"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,12">
                                <Frame Grid.Column="0"
                                       BackgroundColor="#EDE9FE" CornerRadius="10"
                                       WidthRequest="42" HeightRequest="42"
                                       HasShadow="False" Padding="0">
                                    <Label Text="🌙" FontSize="18"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding BedTime, StringFormat='{0:dddd, dd.MM.}'}"
                                           FontSize="14" FontAttributes="Bold" TextColor="#1A2535"/>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding TotalSleepHours, StringFormat='{0:F1}h'}"
                                               FontSize="12" TextColor="#6C757D"/>
                                        <Label Text="·" FontSize="12" TextColor="#9EAAB6"/>
                                        <Label Text="{Binding GoalStatusText}"
                                               FontSize="12" TextColor="#6C757D"/>
                                    </HorizontalStackLayout>
                                    <Border BackgroundColor="#F0EBFF" StrokeThickness="0"
                                            HeightRequest="6" HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="3"/>
                                        </Border.StrokeShape>
                                    </Border>
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding SleepQuality, StringFormat='⭐{0}'}"
                                       FontSize="14" VerticalOptions="Center" TextColor="#F39C12"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>