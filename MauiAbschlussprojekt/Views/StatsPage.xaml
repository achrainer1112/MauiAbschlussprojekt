<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiAbschlussprojekt.ViewModels"
             xmlns:models="clr-namespace:Models;assembly=Models"
             x:Class="MauiAbschlussprojekt.Views.StatsPage"
             x:DataType="viewmodels:StatsViewModel"
             Title="Statistiken"
             BackgroundColor="#F0F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="14">

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="12" RowSpacing="12">

                <Border Grid.Column="0" Grid.Row="0"
                        BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#1A2535" Opacity="0.06" Radius="8" Offset="0,3"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="STREAK" FontSize="10" FontAttributes="Bold"
                               TextColor="#9EAAB6" CharacterSpacing="1"/>
                        <Label Text="{Binding CurrentStreak, StringFormat='🔥 {0}'}"
                               FontSize="24" FontAttributes="Bold" TextColor="#E74C3C"/>
                        <Label Text="Tage aktuell" FontSize="12" TextColor="#9EAAB6"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Grid.Row="0"
                        BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#1A2535" Opacity="0.06" Radius="8" Offset="0,3"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="REKORD" FontSize="10" FontAttributes="Bold"
                               TextColor="#9EAAB6" CharacterSpacing="1"/>
                        <Label Text="{Binding BestStreak, StringFormat='🏆 {0}'}"
                               FontSize="24" FontAttributes="Bold" TextColor="#F39C12"/>
                        <Label Text="Tage beste Serie" FontSize="12" TextColor="#9EAAB6"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Durchschnitt -->
                <Border Grid.Column="0" Grid.Row="1"
                        BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#1A2535" Opacity="0.06" Radius="8" Offset="0,3"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="WOCHE Ø" FontSize="10" FontAttributes="Bold"
                               TextColor="#9EAAB6" CharacterSpacing="1"/>
                        <Label Text="{Binding AverageMl, StringFormat='{0} ml'}"
                               FontSize="22" FontAttributes="Bold" TextColor="#1A73E8"/>
                        <Label Text="pro Tag" FontSize="12" TextColor="#9EAAB6"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Ziel-Info -->
                <Border Grid.Column="1" Grid.Row="1"
                        BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#1A2535" Opacity="0.06" Radius="8" Offset="0,3"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="ZIEL ERREICHT" FontSize="10" FontAttributes="Bold"
                               TextColor="#9EAAB6" CharacterSpacing="1"/>
                        <Label Text="letzte 7 Tage"
                               FontSize="13" FontAttributes="Bold" TextColor="#34A853"/>
                        <Label Text="siehe unten" FontSize="12" TextColor="#9EAAB6"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- 7-Tage-Verlauf -->
            <Label Text="LETZTE 7 TAGE" FontSize="11" FontAttributes="Bold"
                   TextColor="#9EAAB6" CharacterSpacing="1" Margin="4,4,4,0"/>

            <Border BackgroundColor="White" StrokeThickness="0" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1A2535" Opacity="0.07" Radius="10" Offset="0,3"/>
                </Border.Shadow>

                <CollectionView ItemsSource="{Binding WeekStats}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20" Spacing="8">
                            <Label Text="Keine Daten vorhanden"
                                   FontSize="14" TextColor="#9EAAB6"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DailyStatsDto">
                            <Grid ColumnDefinitions="52,*,52"
                                  ColumnSpacing="10"
                                  Padding="0,6">

                                <!-- Wochentag -->
                                <Label Grid.Column="0"
                                       Text="{Binding Date, StringFormat='{0:ddd}'}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="#1A2535"
                                       VerticalOptions="Center"/>

                                <!-- Fortschrittsbalken -->
                                <Grid Grid.Column="1" HeightRequest="10" VerticalOptions="Center">
                                    <!-- Hintergrund -->
                                    <Border BackgroundColor="#EBF2FF" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="5"/>
                                        </Border.StrokeShape>
                                    </Border>
                                    <!-- Fortschritt via ProgressBar (nutzt ProgressValue 0.0–1.0) -->
                                    <ProgressBar Progress="{Binding ProgressValue}"
                                                 ProgressColor="#1A73E8"
                                                 BackgroundColor="Transparent"
                                                 HeightRequest="10"
                                                 VerticalOptions="Center"/>
                                </Grid>

                                <!-- ml-Wert -->
                                <Label Grid.Column="2"
                                       Text="{Binding TotalMl, StringFormat='{0}'}"
                                       FontSize="12" TextColor="#1A73E8"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"/>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- Tages-Einträge -->
            <Label Text="TAGESDETAILS" FontSize="11" FontAttributes="Bold"
                   TextColor="#9EAAB6" CharacterSpacing="1" Margin="4,4,4,0"/>

            <CollectionView ItemsSource="{Binding WeekStats}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30" Spacing="8">
                        <Label Text="📊" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="Keine Statistiken vorhanden"
                               FontSize="14" TextColor="#9EAAB6"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DailyStatsDto">
                        <Border BackgroundColor="White" StrokeThickness="0" Margin="0,0,0,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#1A2535" Opacity="0.05" Radius="6" Offset="0,2"/>
                            </Border.Shadow>
                            <VerticalStackLayout Padding="14,12" Spacing="8">

                                <!-- Datum + Prozent -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Date, StringFormat='{0:dddd, dd.MM.yyyy}'}"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="#1A2535"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Percentage, StringFormat='{0:F0} %'}"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="#1A73E8"
                                           VerticalOptions="Center"/>
                                </Grid>

                                <!-- Fortschrittsbalken -->
                                <ProgressBar Progress="{Binding ProgressValue}"
                                             ProgressColor="#1A73E8"
                                             BackgroundColor="#EBF2FF"
                                             HeightRequest="8"/>

                                <!-- ml von ml -->
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding TotalMl, StringFormat='{0} ml'}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="#1A2535"/>
                                    <Label Text="von"
                                           FontSize="12" TextColor="#9EAAB6"/>
                                    <Label Text="{Binding GoalMl, StringFormat='{0} ml'}"
                                           FontSize="12" TextColor="#9EAAB6"/>
                                    <!-- Ziel-Häkchen -->
                                    <Label Text="✅"
                                           FontSize="12"
                                           IsVisible="{Binding GoalReached}"/>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Zurück Button -->
            <Button Text="Zurück"
                    Command="{Binding BackCommand}"
                    BackgroundColor="#F0F4F8"
                    TextColor="#6C757D"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="46"
                    Margin="0,4,0,0"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="#1A73E8"
                             Margin="20"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>