<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiAbschlussprojekt.ViewModels"
             xmlns:models="clr-namespace:Models;assembly=Models"
             x:Class="MauiAbschlussprojekt.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="💧 Wasser-Tracker">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Header -->
            <Label Text="{Binding Username, StringFormat='Hallo, {0}!'}"
                   FontSize="22"
                   FontAttributes="Bold"/>

            <!-- Progress -->
            <Frame BorderColor="#3498DB" CornerRadius="15" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding TotalMl, StringFormat='{0} ml'}"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#3498DB"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding GoalMl, StringFormat='von {0} ml Tagesziel'}"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                    <ProgressBar Progress="{Binding ProgressPercentage}"
                                 HeightRequest="20"
                                 ProgressColor="#3498DB"/>
                    <Label Text="{Binding ProgressText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#27AE60"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Quick Add Buttons -->
            <Label Text="Schnell hinzufügen:"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="250ml"
                        Command="{Binding QuickAddWaterCommand}"
                        CommandParameter="250"
                        BackgroundColor="#3498DB"
                        TextColor="White"
                        CornerRadius="10"/>
                <Button Grid.Column="1"
                        Text="500ml"
                        Command="{Binding QuickAddWaterCommand}"
                        CommandParameter="500"
                        BackgroundColor="#3498DB"
                        TextColor="White"
                        CornerRadius="10"/>
                <Button Grid.Column="2"
                        Text="750ml"
                        Command="{Binding QuickAddWaterCommand}"
                        CommandParameter="750"
                        BackgroundColor="#3498DB"
                        TextColor="White"
                        CornerRadius="10"/>
                <Button Grid.Column="3"
                        Text="1000ml"
                        Command="{Binding QuickAddWaterCommand}"
                        CommandParameter="1000"
                        BackgroundColor="#3498DB"
                        TextColor="White"
                        CornerRadius="10"/>
            </Grid>

            <!-- Custom Amount -->
            <Label Text="Eigene Menge:"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry Grid.Column="0"
                       Placeholder="Menge in ml"
                       Text="{Binding CustomAmountInput}"
                       Keyboard="Numeric"
                       ReturnCommand="{Binding AddCustomAmountCommand}"/>
                <Button Grid.Column="1"
                        Text="Hinzufügen"
                        Command="{Binding AddCustomAmountCommand}"
                        BackgroundColor="#27AE60"
                        TextColor="White"
                        CornerRadius="10"
                        Padding="20,0"/>
            </Grid>

            <!-- Stats Button -->
            <Button Text="📊 Statistiken anzeigen"
                    Command="{Binding NavigateToStatsCommand}"
                    BackgroundColor="#9B59B6"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,10,0,0"/>

            <!-- Today's Entries -->
            <Label Text="Heutige Einträge:"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,15,0,0"/>

            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                        Command="{Binding LoadTodayDataCommand}">
                <CollectionView ItemsSource="{Binding TodayEntries}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" Spacing="10">
                            <Label Text="💧"
                                   FontSize="60"
                                   HorizontalOptions="Center"/>
                            <Label Text="Noch keine Einträge heute"
                                   FontSize="14"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:WaterEntryDto">
                            <Frame BorderColor="LightGray" 
                                   CornerRadius="10" 
                                   Padding="12" 
                                   Margin="0,0,0,8"
                                   HasShadow="True">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding AmountMl, StringFormat='{0} ml'}"
                                               FontSize="16"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding LoggedAt, StringFormat='{0:HH:mm} Uhr'}"
                                               FontSize="12"
                                               TextColor="Gray"/>
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1"
                                            Text="✏️"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=EditEntryCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#3498DB"
                                            TextColor="White"
                                            CornerRadius="8"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            Padding="0"/>

                                    <Button Grid.Column="2"
                                            Text="🗑️"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=DeleteEntryCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#E74C3C"
                                            TextColor="White"
                                            CornerRadius="8"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            Padding="0"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="#3498DB"
                             Margin="20"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
