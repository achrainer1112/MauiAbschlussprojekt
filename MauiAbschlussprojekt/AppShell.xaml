<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAbschlussprojekt.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiAbschlussprojekt.Views"
    Shell.FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="#1E2A3A"
    Shell.BackgroundColor="#1E2A3A"
    Shell.ForegroundColor="#E8EDF2"
    Shell.TitleColor="#E8EDF2">

    <Shell.Resources>
        <Style TargetType="FlyoutItem">
            <Setter Property="Shell.ItemTemplate">
                <DataTemplate>
                    <Grid HeightRequest="54" Padding="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#2A3A4A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                        <Image Grid.Column="0"
                               Source="{Binding FlyoutIcon}"
                               WidthRequest="22" HeightRequest="22"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{Binding Title}"
                               FontSize="15"
                               TextColor="#E8EDF2"
                               VerticalOptions="Center"
                               Margin="14,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </Setter>
        </Style>
    </Shell.Resources>

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#162032" Padding="20,16,20,20">
            <VerticalStackLayout Spacing="6">
                <Frame x:Name="AvatarFrame"
                       BackgroundColor="#1A73E8"
                       CornerRadius="28"
                       WidthRequest="56"
                       HeightRequest="56"
                       HasShadow="False"
                       Padding="0"
                       HorizontalOptions="Start">
                    <Label x:Name="AvatarLabel"
                           Text="?"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>
                <Label x:Name="FlyoutUsernameLabel"
                       Text="HealthTracker"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#E8EDF2"/>
                <Label Text="Dein Gesundheits-Assistent"
                       FontSize="12"
                       TextColor="#7A8FA6"/>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <Grid BackgroundColor="#111C2A" Padding="20,12" HeightRequest="50">
            <Label Text="Version 1.0"
                   FontSize="12"
                   TextColor="#4A6070"
                   VerticalOptions="Center"/>
        </Grid>
    </Shell.FlyoutFooter>

    <ShellContent Route="LoginPage"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Shell.FlyoutItemIsVisible="False"/>

    <ShellContent Route="RegisterPage"
                  ContentTemplate="{DataTemplate views:RegisterPage}"
                  Shell.FlyoutItemIsVisible="False"/>

    <FlyoutItem Title="Wasser-Tracker" Icon="drop.png">
        <ShellContent Route="WaterTracker"
                      ContentTemplate="{DataTemplate views:MainPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Schlaf-Tracker" Icon="moon.png">
        <ShellContent Route="SleepTracker"
                      ContentTemplate="{DataTemplate views:SleepTrackerPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Einstellungen" Icon="settings.png">
        <ShellContent Route="Settings"
                      ContentTemplate="{DataTemplate views:SettingsPage}"/>
    </FlyoutItem>

</Shell>
