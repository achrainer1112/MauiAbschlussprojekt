<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAbschlussprojekt.MainPage"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Center">

            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Cute dot net bot waving hi to you!" />

            <Label
                Text="Willkommen bei HealthTracker!"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#2196F3" />

            <Label
                Text="Du bist erfolgreich angemeldet."
                FontSize="18"
                HorizontalOptions="Center"
                TextColor="#666666" />

            <Button
                x:Name="LogoutBtn"
                Text="Abmelden"
                Clicked="OnLogoutClicked"
                BackgroundColor="#FF5252"
                TextColor="White"
                FontSize="18"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"
                HorizontalOptions="Fill"
                Margin="0,30,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>